# PromptHash auxiliary server (Express + MongoDB)
# Copy to server/.env when running the backend locally.

# Required for server features (draft lifecycle, buyer collections, chat)
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-hash-stellar

# CORS Configuration
# Comma-separated list of allowed origins
# Leave empty to block all cross-origin requests
# Example: https://app.promptmint.xyz,https://admin.promptmint.xyz
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional — email notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Optional — S3 backup (see docs/operations/backup-and-recovery.md)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Optional — Redis cache and large-transaction audit threshold (stroops).
# REDIS_URL=redis://127.0.0.1:6379
# AUDIT_LARGE_TRANSACTION_STROOPS=100000000

# Optional - run a daily isolated restore verification against the latest
# successful backup. Set the restore URI separately for production safety.
# ENABLE_RESTORE_DRILL=false
# RESTORE_DRILL_CRON=0 3 * * *
# MONGODB_URI_RESTORE=mongodb://127.0.0.1:27017/prompt-hash-restore
# BACKUP_ALERT_WEBHOOK=https://example.invalid/backup-alerts
